!f() { t=$1; if [ -z \"$t\" ]; then echo 'Error: Missing commit hash.'; return 1; fi; git rev-parse --verify \"$t\" >/dev/null 2>&1 || { echo 'Error: Commit hash not found.'; return 1; }; echo \"Targeting: $(git log -1 --format='%h %s' $t)\"; echo 'Step 1: Creating fixup...'; git commit --fixup=$t; echo 'Step 2: Rewriting history...'; GIT_SEQUENCE_EDITOR=: git rebase -i --autosquash --autostash \"$t~1\"; echo '✅ Success! Now run: git push --force-with-lease'; }; f
